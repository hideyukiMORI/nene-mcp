{
    "name": "hideyukimori/nene-mcp",
    "description": "Standalone PHP stdio MCP server for NeNe / NENE2-style OpenAPI tool catalogs",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/hideyukiMORI/nene-mcp",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "nene",
        "nene2",
        "php",
        "openapi",
        "stdio",
        "json-rpc"
    ],
    "authors": [
        {
            "name": "Hideyuki MORI",
            "email": "info@ayane.co.jp"
        }
    ],
    "support": {
        "issues": "https://github.com/hideyukiMORI/nene-mcp/issues",
        "source": "https://github.com/hideyukiMORI/nene-mcp"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "bin": [
        "bin/nene-mcp"
    ],
    "autoload": {
        "psr-4": {
            "HideyukiMori\\NeneMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HideyukiMori\\NeneMcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.dist.xml"
    },
    "suggest": {
        "hideyukimori/nene": "Reference template when combining OpenAPI with NeNe",
        "hideyukimori/nene2": "Ship tool catalogs matching NENE2 docs/mcp/tools.json format"
    }
}
